{
  "cli": {
    "version": ">= 21.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "IRONCLAW_APP_ENV": "development"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "IRONCLAW_APP_ENV": "preview"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "iphone": {
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "env": {
        "IRONCLAW_APP_ENV": "development"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "IRONCLAW_APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
