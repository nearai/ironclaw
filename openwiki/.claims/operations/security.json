    {
      "id": "claim_7a712a543ff84ca1b58047d8cb396461",
      "statement": "The process sandbox lane (ironclaw_sandbox) runs OS processes inside Docker with one persistent container per (tenant, user) pair, per-tenant CA for container identity, credential firewall, managed egress via private proxy with hostname allowlist and TLS SNI inspection, and audit trail draining before container removal.",
      "evidence": [
        {
          "resource": "repo://crates/lanes/ironclaw_sandbox/README.md#L1-L50",
          "version": "repo-lines-v1:sha256:41a61e1d7d28937da6baf632a7abce486420bbdcd9d0e91d93ee421636568228:"
