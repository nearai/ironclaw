        }
      ]
    },
    {
      "id": "claim_df57efff6f964da0be8e5ee834ab3739",
      "statement": "Four sealed artifacts prove pipeline stages completed: the Authorized witness (minted only by ironclaw_capabilities), EffectiveTrustClass (privileged variants private, no Deserialize), fingerprinted approval leases, and resource receipts. Each has exactly one sanctioned mint.",
      "evidence": [
