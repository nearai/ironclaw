        }
      ]
    },
    {
      "id": "claim_6daaa8a0b38b4de49452565591f10131",
      "statement": "Commands in the sandbox are specified as typed SandboxProcessPlan with sub-vocabularies for install, command, mounts, network, and credentials; no raw host paths, environment inheritance, or secret material in plan input; the plan contract makes raw specifications impossible.",
