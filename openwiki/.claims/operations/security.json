    {
      "id": "claim_bafd95ffbb2f4ebba3c59cf19a0ceb91",
      "statement": "The WASM sandbox lane (ironclaw_wasm) executes components under deny-by-default host imports with fresh store per call, fuel/epoch/memory/table/instance ceilings, aggregate multi-memory accounting, and guest diagnostics bounded to 4 KiB without UTF-8 splitting.",
