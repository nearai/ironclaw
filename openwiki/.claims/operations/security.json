    {
      "id": "claim_e8b52460e4344b9199cf809b410e09ca",
      "statement": "The credential firewall is a staging chokepoint where only handle-bound material reaches the sandbox transport; the process receives a placeholder, the private proxy holds the real secret and replaces the placeholder only for approved hosts with valid TLS, and the real credential never appears in logs or transcripts.",
      "evidence": [
        {
