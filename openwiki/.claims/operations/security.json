  "claims": [
    {
      "id": "claim_9c1389376c5c4b049c602f49ce291da8",
      "statement": "The kernel is a nine-stage pipeline where every privileged operation must pass through admission, claimed execution, trust evaluation, authorization, approval, resource reservation, policy planning, membrane sealing, and mediated execution in order. No operation bypasses this boundary.",
      "evidence": [
        {
          "resource": "repo://crates/Architecture.md#L123-L150",
          "version": "repo-lines-v1:sha256:87b2f3e7dd4f0734a34f19f6ef624ea2bc560555a8fdcc73200c87527fc7999c:"
        },
        {
