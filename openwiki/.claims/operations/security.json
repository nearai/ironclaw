          "version": "repo-file-v1:sha256:18dcff5e5ffe0dd8acb6ff68787f6bbd23e28f1a9c4bcfab3cd16dcd8c97f9ec"
        }
      ]
    },
    {
      "id": "claim_559bdfb3fda2433298b190c5fd77275c",
      "statement": "Trust is a ceiling, never a bypass: even FirstParty and System trust levels require explicit grants, scoped mounts, leases, resource budget, and obligation handling through the same kernel pipeline as untrusted code.",
