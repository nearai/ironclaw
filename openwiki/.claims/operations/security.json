    },
    {
      "id": "claim_7d60c61877534392b5a6fe1d16aa6769",
      "statement": "Authorization is default-deny: a request is denied unless an explicit grant matches the caller's scope and requested effect, the grant does not exceed the trust ceiling, no approval is required or an approval lease is held, and resource capacity is available.",
      "evidence": [
        {
          "resource": "repo://crates/kernel/ironclaw_authorization/README.md#L47-L56",
          "version": "repo-lines-v1:sha256:7513e569af99c3346c7aa99f07a22b98bf23e1f34c9a1d30493484836c7b1418:"
        }
      ]
    },
    {
      "id": "claim_745324efd8e5408e920a6305928297d2",
      "statement": "ironclaw_secrets enforces one-shot consumption: raw material is readable exactly once per lease. Secrets are encrypted on host with AES-GCM, master key stored in OS keychain, never serialized or on disk, injected only at runtime via credential placeholders, never in config or debug output.",
      "evidence": [
        {
          "resource": "repo://crates/substrates/ironclaw_secrets/README.md#L1-L10",
