          "version": "repo-lines-v1:sha256:1e964b5f82aa313402c1c2b31528e082c7c3bf317ffb235b1274a35d7510c3c2:"
        }
      ]
    },
    {
      "id": "claim_bd022a6bb8b04919be721d87aeccbb45",
      "statement": "WebUI authentication requires IRONCLAW_REBORN_WEBUI_TOKEN (32+ hex bytes) and IRONCLAW_REBORN_WEBUI_USER_ID. Both are required; ironclaw serve exits if either is missing. These control HTTP bearer authentication and user context for WebUI requests.",
      "evidence": [
        {
          "resource": "repo://crates/app/ironclaw_cli/src/webui_token.rs#L1-L50",
          "version": "repo-lines-v1:sha256:0360ca4a881304c9966eb420825e5636e0fefedffffe88582baeca5fd7edba6e:"
