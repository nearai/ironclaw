        }
      ]
    },
    {
      "id": "claim_ef7ac139315f4eae8e684f401e6c5bbe",
      "statement": "ironclaw_filesystem provides RootFilesystem trait with unified dispatch: one virtual path space, scoped access with mount grants, compare-and-swap floor for transactionality, and multiple backends (libSQL, PostgreSQL, JSONL, disk) implementing the same observable contract.",
