    },
    {
      "id": "claim_73ba408e9c11487b809ad930efa1830d",
      "statement": "Storage is abstracted across four layers: ironclaw_event_log (vocabulary only, no driver), ironclaw_event_store (backend selection and fail-closed policy), ironclaw_filesystem (RootFilesystem trait with unified dispatch), and concrete backends (libSQL, PostgreSQL, JSONL).",
      "evidence": [
        {
          "resource": "repo://crates/events/ironclaw_event_log/README.md#L1-L20",
          "version": "repo-lines-v1:sha256:03db6bb2973114b1746ea918f3c2fb486decfb2b409918aa998adada7b962e86:"
