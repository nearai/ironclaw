        }
      ]
    },
    {
      "id": "claim_fc218dcd63d8433d88d1a4650d67327c",
      "statement": "libSQL (SQLite with WAL) is the default backend: single-node durable, built-in with Reborn, uses ironclaw_libsql_runtime which provides one reader pool (8 slots, query-only) and one single-slot writer lane per database to enforce the SQLite single-writer invariant.",
      "evidence": [
        {
          "resource": "repo://crates/events/ironclaw_event_store/src/lib.rs#L150-L157",
          "version": "repo-lines-v1:sha256:92e2367d6c5f781ec33951a5fecd10b35d8c0dd82a939c36181208b847a85796:"
