        }
      ]
    },
    {
      "id": "claim_f67b90fdbd914e1d9c3e3c2035e2bb23",
      "statement": "Events are redacted at construction time: constructors collapse unsafe error categories into bounded classifications and never store raw secrets, host paths, prompts, tool payloads, or approval reasons.",
