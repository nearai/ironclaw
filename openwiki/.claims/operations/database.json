          "resource": "repo://crates/events/ironclaw_event_log/README.md#L52-L66",
          "version": "repo-lines-v1:sha256:11d0ad3d3eaec9be17f77e9efa462f3ea85e22967cc836366866aa29ebcf86e2:"
