        }
      ]
    },
    {
      "id": "claim_148ee0e9b44f4e0485853ada10685cc6",
      "statement": "Runtime events carry typed event kinds (DispatchRequested, ModelCompleted, LoopFailed, etc.), are scoped by tenant/user/agent/thread/process, and include metadata-only sanitized details like duration, provider, and error kind without raw payloads or secrets.",
