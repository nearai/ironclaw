        }
      ]
    },
    {
      "id": "claim_fa2b6d70098a42d7a706bac26d6160e9",
      "statement": "PostgreSQL backend supports multi-node high-availability deployments with ACID transactions and replication; remote connections require sslmode=require; fail-closed policy rejects cleartext unless explicitly allowed; driver cone isolated to ironclaw_event_store.",
      "evidence": [
        {
          "resource": "repo://crates/events/ironclaw_event_store/src/lib.rs#L141-L144",
          "version": "repo-lines-v1:sha256:72de26348ebb67cfdb722d63bb13e8decb5d65cd6f6cb562133d404fe2e53a44:"
