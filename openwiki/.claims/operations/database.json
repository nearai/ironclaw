        }
      ]
    },
    {
      "id": "claim_94557a1efcfb4aecb7d4664415eeba3a",
      "statement": "Projections are computed read models (thread timeline, run status, capability activity) derived from events via replay; they are deterministic, side-effect-free, rebuildable, metadata-only, and scoped to enforce access boundaries.",
      "evidence": [
        {
          "resource": "repo://crates/events/ironclaw_event_projections/README.md#L1-L30",
          "version": "repo-lines-v1:sha256:3eca1a4799f07a81cb87853dda769d0b71fcae5628afa94be00c2ca157bb54b5:"
        },
        {
          "resource": "repo://crates/events/ironclaw_event_projections/src/lib.rs#L1-L60",
          "version": "repo-lines-v1:sha256:79d460e645af9211bb1aa7006cf9ed82201db137d221efa77410e5ef53c3b027:"
        }
      ]
    },
    {
      "id": "claim_2922d29627ba4d919716742923afbf4c",
      "statement": "Projections use cursor-based resume (not byte offsets): snapshots rebuild from origin cursor, updates fold events after a stored cursor, replay gaps trigger rebase required, and cursors are scope-bound to prevent cross-thread contamination.",
      "evidence": [
        {
          "resource": "repo://crates/events/ironclaw_event_projections/src/lib.rs#L98-L140",
          "version": "repo-lines-v1:sha256:c397f9220aa086b7b049d840968e76e7e57f22a8edcd982bd9423b85c625079e:"
        },
        {
