        {
          "resource": "repo://crates/events/ironclaw_event_store/src/lib.rs#L173-L218",
          "version": "repo-lines-v1:sha256:0e4efbcd4d48f66c5d7b25c84448df85eb5f6d419e211e16f1b5c2c4008b3f3a:"
