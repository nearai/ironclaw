    {
      "id": "claim_61eef6a1de7044598f539ede243d01b4",
      "statement": "Event projections use scope-bound cursors; a cursor returned for one thread must not be replayed under another thread's scope without scope-matching; scope mismatches are detected and return ProjectionError::RebaseRequired so consumers know to re-snapshot rather than silently lose data.",
      "evidence": [
        {
          "resource": "repo://crates/events/ironclaw_event_projections/src/lib.rs#L98-L139",
