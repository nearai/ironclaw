  "claims": [
    {
      "id": "claim_16db75abda004d2b8bf113806d6eb5b9",
      "statement": "Channel adapters are stateless protocol translators that parse vendor message formats and render replies. The host owns all durable state including secrets, sessions, bindings, and delivery records.",
      "evidence": [
        {
          "resource": "repo://crates/contracts/ironclaw_extension_contracts/src/channel_adapter.rs#L1-L50",
          "version": "repo-lines-v1:sha256:715d98d94459f2bfd2441504488320a4bcd304181d5f1af4d12da88cf1fa78ca:"
        },
        {
          "resource": "repo://docs/internal/reborn/how-to-port-channel-to-reborn.md#L48-L87",
          "version": "repo-lines-v1:sha256:47f3374a60b9cd5c25bc700fce97b093d3bf3af8a0c2fca2ce7bcacb9d5b78d4:"
        }
      ]
    },
    {
      "id": "claim_7eb11582c51643729d9e9c7ee86822ac",
      "statement": "ChannelAdapter contracts split into three optional halves: ChannelIngress (parse inbound), ChannelDelivery (render and post outbound), and ReplySink (stream or materialize replies). Adapters implement only the halves their manifest declares.",
      "evidence": [
        {
          "resource": "repo://crates/contracts/ironclaw_extension_contracts/src/channel_adapter.rs#L57-L175",
          "version": "repo-lines-v1:sha256:8454d8942af0f29e28a010dcc113b3aeb78d16947f7fac01c3edac4c3df60d73:"
        }
      ]
    },
    {
      "id": "claim_3e7c575af9db4e7980c08fe8ce198688",
      "statement": "ChannelIngress::receive is called only after host verification; it receives the verified installation_id, non-secret manifest config, and request body. The adapter returns NormalizedInboundMessage with untrusted bounds that the host validates.",
      "evidence": [
        {
          "resource": "repo://crates/contracts/ironclaw_extension_contracts/src/channel_adapter.rs#L57-L69",
          "version": "repo-lines-v1:sha256:fddfc5194c874d9f840cd2c7bc8bce377fbc2fdcd6fb3982f7c70b74067c83ff:"
        },
        {
          "resource": "repo://crates/extensions/ironclaw_extension_host/src/ingress/router.rs#L40-L120",
          "version": "repo-lines-v1:sha256:3e9947c8b4f882de306ea1036ea03f3e2a8282c6d8a5b727ede0e34b66109da7:"
        }
      ]
    },
    {
      "id": "claim_19067019c8164c43953bdab04dbb554a",
      "statement": "The host ingress router verifies protocol authentication (signature, shared secret) before calling the adapter. Signing secrets are host-resolved and consumed by the constant-time verifier; the adapter never sees them.",
      "evidence": [
        {
          "resource": "repo://crates/extensions/ironclaw_extension_host/src/ingress/router.rs#L55-L82",
          "version": "repo-lines-v1:sha256:def0431e9559f1365d7c440bde7dd98fd170ffe4233dbfd9a75d6e81edb6f67e:"
        },
        {
          "resource": "repo://crates/extensions/ironclaw_extension_host/src/ingress/verifier.rs#L1-L152",
          "version": "repo-lines-v1:sha256:99563ad6683a2be93ca4a5c767cac6f84f7eb3952580cf41dc59cb6d93da361c:"
        }
      ]
    },
    {
      "id": "claim_59c15ca128ae4f2ba19a7d02e69a865d",
      "statement": "VerifiedInbound carries only non-secret manifest-declared configuration. Secret material remains host-side. This prevents adapters from accessing signing secrets or API keys.",
      "evidence": [
        {
          "resource": "repo://crates/contracts/ironclaw_extension_contracts/src/channel_adapter.rs#L227-L248",
          "version": "repo-lines-v1:sha256:d8b8213c2974f3ffb7b52d0a9f6255a78dbe1b55926fd2b8749f537a43661253:"
        }
      ]
    },
    {
      "id": "claim_ed8a0c3a31824c56abe42f4eaceb2312",
      "statement": "The host runs a durable admission transaction keyed by (installation_id, external_event_id) that records idempotency, resolves conversation binding, and commits turn submission. Duplicate vendor retries replay the original accepted message.",
      "evidence": [
        {
          "resource": "repo://crates/extensions/ironclaw_extension_host/src/ingress/router.rs#L83-L119",
          "version": "repo-lines-v1:sha256:3c5d693090484cb49b732fe4b5a5db40e317a5e775652c79bc2cf9369905cee9:"
        },
        {
          "resource": "repo://docs/internal/reborn/contracts/conversation-binding.md#L115-L127",
