    {
      "id": "claim_fffb6e1d3792451a9ff344ab28f32e6b",
      "statement": "Adapters call vendor APIs through RestrictedEgress, which validates endpoints against manifest-declared egress hosts. Secrets are injected by the host using SecretHandle references; adapters never embed credentials.",
