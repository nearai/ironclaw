    {
      "id": "claim_d51a45fae4c44681abff46a93bc53071",
      "statement": "Delivery outcomes are typed: Sent (success), Retryable (5xx/timeout), Ambiguous (crossed transport), Permanent (deterministic failure), Unauthorized (auth revoked). Only Retryable triggers coordinator retry.",
