{
  "name": "ironclaw-webui-v2-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Build tooling for the WebUI v2 SPA. Vite builds the TypeScript source and public assets into ignored dist/ output that Rust embeds when webui-v2-beta is enabled.",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "engines": {
    "node": ">=22.22 <23",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && pnpm check:bundle",
    "check:bundle": "node --experimental-strip-types scripts/check-bundle-budgets.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:conventions && pnpm typecheck",
    "lint:conventions": "node --experimental-strip-types scripts/check-source-conventions.ts",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "vendor": "bash vendor.sh",
    "all": "bash build.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.87.4",
    "dompurify": "3.4.12",
    "event-source-plus": "0.1.15",
    "gemoji": "8.0.0",
    "highlight.js": "11.11.1",
    "marked": "17.0.2",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.62.0",
    "react-hot-toast": "2.6.0",
    "react-router": "8.3.0",
    "remark-gemoji": "8.0.0",
    "streamdown": "2.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "26.1.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "happy-dom": "20.11.1",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vitest": "4.1.9",
    "storybook": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@chromatic-com/storybook": "5.3.0",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-mcp": "0.7.0",
    "@vitest/browser-playwright": "4.1.9",
    "playwright": "1.62.1"
  }
}
