{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Standard messaging delete_message output",
  "type": "object",
  "required": ["deleted", "message_ref"],
  "properties": {
    "deleted": {
      "const": true,
      "description": "Literal true; a delete that did not happen is a messaging error, never deleted: false."
    },
    "message_ref": {
      "type": "object",
      "required": ["conversation", "message_id"],
      "properties": {
        "conversation": { "type": "string", "minLength": 1 },
        "message_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "description": "The exact object returned by a prior send or read on this extension."
    },
    "vendor": { "type": "object" }
  },
  "additionalProperties": false
}
