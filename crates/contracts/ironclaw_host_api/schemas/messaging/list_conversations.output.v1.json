{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Standard messaging list_conversations output",
  "type": "object",
  "required": ["conversations"],
  "properties": {
    "conversations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conversation", "kind"],
        "properties": {
          "conversation": {
            "type": "string",
            "minLength": 1,
            "description": "Conversation ref for this extension, from list_conversations / open_dm / get_conversation_info or an earlier result. Never invented; never valid on another extension."
          },
          "kind": {
            "type": "string",
            "enum": ["dm", "group_dm", "channel", "other"],
            "description": "Conversation kind: dm, group_dm, channel, or other."
          },
          "display_name": { "type": "string" },
          "is_member": { "type": "boolean" },
          "counterpart": {
            "type": "object",
            "required": ["user_ref"],
            "properties": {
              "user_ref": { "type": "string", "minLength": 1 },
              "display_name": { "type": "string" }
            },
            "additionalProperties": false,
            "description": "The other participant, for a dm conversation."
          },
          "vendor": { "type": "object" }
        },
        "allOf": [
          {
            "if": {
              "required": ["kind"],
              "properties": { "kind": { "const": "dm" } }
            },
            "then": { "required": ["counterpart"] }
          }
        ],
        "additionalProperties": false
      }
    },
    "next_cursor": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque pagination cursor; pass as cursor on the next call to continue."
    },
    "vendor": { "type": "object" }
  },
  "additionalProperties": false
}
