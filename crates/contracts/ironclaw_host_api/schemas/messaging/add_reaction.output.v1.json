{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Standard messaging add_reaction output",
  "type": "object",
  "required": ["message_ref", "emoji"],
  "properties": {
    "message_ref": {
      "type": "object",
      "required": ["conversation", "message_id"],
      "properties": {
        "conversation": { "type": "string", "minLength": 1 },
        "message_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "description": "The exact object returned by a prior send or read on this extension."
    },
    "emoji": {
      "type": "string",
      "minLength": 1,
      "description": "The vendor's emoji token (name or unicode); the addendum documents the dialect."
    },
    "vendor": { "type": "object" }
  },
  "additionalProperties": false
}
