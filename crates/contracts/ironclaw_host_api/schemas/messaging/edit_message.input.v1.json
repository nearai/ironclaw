{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Standard messaging edit_message input",
  "type": "object",
  "required": ["message_ref", "text"],
  "properties": {
    "message_ref": {
      "type": "object",
      "required": ["conversation", "message_id"],
      "properties": {
        "conversation": { "type": "string", "minLength": 1 },
        "message_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "description": "The exact object returned by a prior send or read on this extension."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "Replacement message text (markdown baseline; rendered per channel)."
    }
  },
  "additionalProperties": false
}
