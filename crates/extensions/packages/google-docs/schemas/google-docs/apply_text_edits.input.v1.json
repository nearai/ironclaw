{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Google Docs apply_text_edits",
  "description": "Apply validated text-anchored replacements atomically.",
  "type": "object",
  "required": ["document_id", "edits"],
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "The document ID."
    },
    "edits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["find", "replace"],
        "properties": {
          "find": { "type": "string", "minLength": 1, "maxLength": 10000, "description": "Exact anchor text to replace." },
          "replace": { "type": "string", "maxLength": 10000, "description": "Replacement text." },
          "replace_all": { "type": "boolean", "default": false, "description": "Replace every occurrence instead of requiring a unique anchor." },
          "match_case": { "type": "boolean", "default": true, "description": "Use case-sensitive matching." }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
