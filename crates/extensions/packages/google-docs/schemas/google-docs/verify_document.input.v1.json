{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Google Docs verify_document",
  "description": "Verify expected text and table contents against current provider state.",
  "type": "object",
  "required": ["document_id"],
  "properties": {
    "document_id": { "type": "string", "minLength": 1, "maxLength": 256, "description": "The document ID." },
    "expected_text": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 10000 },
      "description": "Text fragments that must each occur."
    },
    "expected_tables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["table_data"],
        "properties": {
          "table_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "description": "Optional zero-based table position; defaults to this expectation's position."
          },
          "table_data": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": { "type": "string", "maxLength": 10000 }
            }
          }
        },
        "additionalProperties": false
      },
      "description": "Tables that must match by document order."
    }
  },
  "anyOf": [
    { "required": ["expected_text"] },
    { "required": ["expected_tables"] }
  ],
  "additionalProperties": false
}
