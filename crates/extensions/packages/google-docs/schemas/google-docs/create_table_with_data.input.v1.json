{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Google Docs create_table_with_data",
  "description": "Insert, populate, optionally style, and verify a rectangular table.",
  "type": "object",
  "required": ["document_id", "index", "table_data"],
  "properties": {
    "document_id": { "type": "string", "minLength": 1, "maxLength": 256, "description": "The document ID." },
    "index": { "type": "integer", "minimum": 1, "description": "Character index at which to insert the table." },
    "table_data": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "description": "Rectangular row-major cell contents.",
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": { "type": "string", "maxLength": 10000 }
      }
    },
    "bold_header": { "type": "boolean", "default": false, "description": "Bold the first row." }
  },
  "additionalProperties": false
}
