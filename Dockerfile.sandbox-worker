# syntax=docker/dockerfile:1.7

FROM rust:1.96-bookworm@sha256:5e2214abe154fe26e39f64488952e5c991eeed1d6d6da7cc8381ae83927f0cfc AS loop_worker_builder

WORKDIR /app
COPY .cargo/config.toml .cargo/config.toml
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY tools/ironclaw_stress/ tools/ironclaw_stress/
COPY skills/ skills/
COPY migrations/ migrations/
COPY tests/ tests/
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/app/target,sharing=locked \
    mkdir -p src \
    && printf 'fn main() {}\n' > src/main.rs \
    && cargo build --release \
        --package ironclaw_turn_runner \
        --bin ironclaw-loop-worker \
    && cp target/release/ironclaw-loop-worker /ironclaw-loop-worker

# Pi loop worker, compiled for the final image's architecture and glibc runtime.
# Keep the Bun version pinned by digest; bump version + digest together.
FROM oven/bun:1.3.14-alpine@sha256:5acc90a93e91ff07bf72aa90a7c9f0fa189765aec90b47bdbf2152d2196383c0 AS pi_worker_builder

ARG TARGETARCH
WORKDIR /pi-worker
COPY docker/sandbox/pi-worker/package.json docker/sandbox/pi-worker/bun.lock ./
RUN bun install --frozen-lockfile
COPY docker/sandbox/pi-worker/src ./src
RUN case "$TARGETARCH" in \
        amd64) target=bun-linux-x64 ;; \
        arm64) target=bun-linux-arm64 ;; \
        *) echo "Unsupported worker architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && bun build --compile --target="$target" src/main.ts --outfile /ironclaw-pi-worker

# Phase 2 worker for the persistent local-Docker user sandbox.
# Keep the base digest aligned with RailwayPreviewSandboxConfig's default.
FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        gh \
        jq \
        nodejs \
        npm \
        tini \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 sandbox \
    && useradd --uid 1000 --gid sandbox --create-home --shell /bin/sh sandbox

COPY --chmod=0755 docker/sandbox/ironclaw-exec \
    docker/sandbox/ironclaw-sandbox-idle \
    /usr/local/bin/
COPY --from=loop_worker_builder --chmod=0755 \
    /ironclaw-loop-worker \
    /usr/local/bin/ironclaw-loop-worker
COPY --from=pi_worker_builder --chmod=0755 \
    /ironclaw-pi-worker \
    /usr/local/bin/ironclaw-pi-worker
ENV HOME=/home/sandbox \
    GH_CONFIG_DIR=/workspace/.config/gh
USER 1000:1000

ENTRYPOINT ["tini", "--"]
CMD ["/usr/local/bin/ironclaw-sandbox-idle"]
