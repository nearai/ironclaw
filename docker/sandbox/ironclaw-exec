#!/bin/sh

set -u

readonly MAX_TIMEOUT_SECONDS=86400
readonly TERMINATION_GRACE_SECONDS=1

usage() {
    echo "usage: ironclaw-exec <timeout-seconds> <outcome-nonce> <command>" >&2
    exit 64
}

[ "$#" -eq 3 ] || usage

timeout_seconds=$1
outcome_nonce=$2
command=$3

case "$timeout_seconds" in
    ''|*[!0-9]*) usage ;;
esac
while [ "${timeout_seconds#0}" != "$timeout_seconds" ]; do
    timeout_seconds=${timeout_seconds#0}
done
[ -n "$timeout_seconds" ] || usage
case "$timeout_seconds" in
    ??????*) usage ;;
esac
[ "$timeout_seconds" -le "$MAX_TIMEOUT_SECONDS" ] || usage

case "$outcome_nonce" in
    ''|*[!0-9a-f-]*) usage ;;
esac

record_outcome() {
    # The supervisor writes the final line only after the command group is
    # gone. The host matches this invocation-specific trailer in an uncapped
    # tail buffer, so an earlier command-written lookalike cannot win.
    printf '\n__IRONCLAW_EXEC_OUTCOME_%s=%s\n' "$outcome_nonce" "$1"
}

# The container already runs as its configured non-root identity.
setsid sh -c "$command" </dev/null &
command_pid=$!

group_is_live() {
    kill -0 "-$command_pid" >/dev/null 2>&1
}

terminate_group() {
    if group_is_live; then
        kill -TERM "-$command_pid" >/dev/null 2>&1 || :
        sleep "$TERMINATION_GRACE_SECONDS" </dev/null >/dev/null 2>&1
        kill -KILL "-$command_pid" >/dev/null 2>&1 || :
        return 0
    fi
    return 1
}

timeout_fired=false
on_timeout() {
    # A late USR1 after the foreground group exited is not a timeout.
    if group_is_live; then
        timeout_fired=true
        terminate_group || :
    fi
}
trap on_timeout USR1

wrapper_pid=$$
(
    sleep "$timeout_seconds"
    kill -USR1 "$wrapper_pid"
) </dev/null >/dev/null 2>&1 &
watchdog_pid=$!

wait "$command_pid"
command_status=$?

kill "$watchdog_pid" >/dev/null 2>&1 || :
wait "$watchdog_pid" >/dev/null 2>&1 || :
trap - USR1

if [ "$timeout_fired" = true ]; then
    wait "$command_pid" >/dev/null 2>&1 || :
    terminate_group || :
    record_outcome timeout
    exit 0
fi

# A foreground shell can exit while jobs in its process group remain.
terminate_group || :
record_outcome "exit:$command_status"
exit 0
