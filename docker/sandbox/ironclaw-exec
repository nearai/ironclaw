#!/bin/sh

set -u

readonly MAX_TIMEOUT_SECONDS=86400
readonly TERMINATION_GRACE_SECONDS=1

usage() {
    echo "usage: ironclaw-exec <timeout-seconds> <command>" >&2
    exit 64
}

[ "$#" -eq 2 ] || usage

timeout_seconds=$1
command=$2

case "$timeout_seconds" in
    ''|*[!0-9]*) usage ;;
esac

# Normalize leading zeroes before using test(1), and bound the value before any
# numeric comparison so an oversized argv value cannot overflow test(1).
while [ "${timeout_seconds#0}" != "$timeout_seconds" ]; do
    timeout_seconds=${timeout_seconds#0}
done
[ -n "$timeout_seconds" ] || usage
case "$timeout_seconds" in
    ??????*) usage ;;
esac
[ "$timeout_seconds" -le "$MAX_TIMEOUT_SECONDS" ] || usage

# Docker Exec owns stdout and stderr, so the command must inherit them. stdin is
# closed explicitly. The exec-mechanics spike showed that a deliberately
# detached descendant must also redirect its own stdout and stderr or Docker
# will keep its stream open; a shell wrapper cannot identify only those
# descendants without also losing foreground output. The watchdog below uses
# /dev/null for all three descriptors and therefore never holds the stream.
setsid sh -c "$command" </dev/null &
command_pid=$!

terminate_group() {
    if kill -0 "-$command_pid" >/dev/null 2>&1; then
        kill -TERM "-$command_pid" >/dev/null 2>&1 || :
        sleep "$TERMINATION_GRACE_SECONDS" </dev/null >/dev/null 2>&1
        kill -KILL "-$command_pid" >/dev/null 2>&1 || :
    fi
}

timeout_fired=false
on_timeout() {
    timeout_fired=true
    terminate_group
}
trap on_timeout USR1

wrapper_pid=$$
(
    sleep "$timeout_seconds"
    kill -USR1 "$wrapper_pid"
) </dev/null >/dev/null 2>&1 &
watchdog_pid=$!

wait "$command_pid"
command_status=$?

# Stop and reap the watchdog. A deadline signal runs terminate_group in this
# shell, so no command-writable file is trusted to decide timeout status.
kill "$watchdog_pid" >/dev/null 2>&1 || :
wait "$watchdog_pid" >/dev/null 2>&1 || :
trap - USR1

if [ "$timeout_fired" = true ]; then
    wait "$command_pid" >/dev/null 2>&1 || :
    terminate_group
    exit 124
fi

# A foreground shell can exit while jobs in its process group remain. Remove
# those jobs so they cannot outlive the invocation or retain Docker Exec's
# capture descriptors.
terminate_group

if [ "$timeout_fired" = true ]; then
    exit 124
fi
exit "$command_status"
