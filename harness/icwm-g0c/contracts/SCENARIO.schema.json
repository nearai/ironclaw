{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:ironclaw:icwm-g0c:scenario:v1",
  "type":"object","additionalProperties":false,"required":["schema_version","scenario_id","name","inputs","expected_effects","failpoints"],
  "properties":{"schema_version":{"const":"icwm.g0c.scenario.v1"},"scenario_id":{"$ref":"#/$defs/hash"},"name":{"type":"string","minLength":1},"inputs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/input"}},"expected_effects":{"type":"array","items":{"$ref":"#/$defs/effect"}},"failpoints":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/failpoint"}}},
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"text":{"type":"string"},"nonempty":{"type":"string","minLength":1},"uint":{"type":"integer","minimum":0},"bytes":{"type":"array","items":{"type":"integer","minimum":0,"maximum":255}},
    "input":{"oneOf":[
      {"$ref":"#/$defs/begin"},{"$ref":"#/$defs/step"},{"$ref":"#/$defs/sync"},{"$ref":"#/$defs/deviceKeys"},{"$ref":"#/$defs/oneTimeKeys"},{"$ref":"#/$defs/toDevice"},{"$ref":"#/$defs/roomEvent"},{"$ref":"#/$defs/emit"},{"$ref":"#/$defs/consume"},{"$ref":"#/$defs/cancel"},{"$ref":"#/$defs/stale"}
    ]},
    "begin":{"type":"object","additionalProperties":false,"required":["type","data"],"properties":{"type":{"const":"begin_operation"},"data":{"$ref":"#/$defs/operation"}}},
    "step":{"type":"object","additionalProperties":false,"required":["type","data"],"properties":{"type":{"const":"step_operation"},"data":{"type":"object","additionalProperties":false,"required":["operation_id","step"],"properties":{"operation_id":{"$ref":"#/$defs/hash"},"step":{"$ref":"#/$defs/text"}}}}},
    "sync":{"type":"object","additionalProperties":false,"required":["type","data"],"properties":{"type":{"const":"sync"},"data":{"type":"object","additionalProperties":false,"required":["next_batch","body"],"properties":{"next_batch":{"$ref":"#/$defs/text"},"body":{"$ref":"#/$defs/bytes"}}}}},
    "deviceKeys":{"type":"object","additionalProperties":false,"required":["type","data"],"properties":{"type":{"const":"device_keys"},"data":{"type":"object","additionalProperties":false,"required":["user_id","body"],"properties":{"user_id":{"$ref":"#/$defs/nonempty"},"body":{"$ref":"#/$defs/bytes"}}}}},
    "oneTimeKeys":{"type":"object","additionalProperties":false,"required":["type","data"],"properties":{"type":{"const":"one_time_keys"},"data":{"type":"object","additionalProperties":false,"required":["user_id","device_id","body"],"properties":{"user_id":{"$ref":"#/$defs/nonempty"},"device_id":{"$ref":"#/$defs/nonempty"},"body":{"$ref":"#/$defs/bytes"}}}}},
    "toDevice":{"type":"object","additionalProperties":false,"required":["type","data"],"properties":{"type":{"const":"to_device"},"data":{"type":"object","additionalProperties":false,"required":["sender","event_type","body"],"properties":{"sender":{"$ref":"#/$defs/nonempty"},"event_type":{"$ref":"#/$defs/nonempty"},"body":{"$ref":"#/$defs/bytes"}}}}},
    "roomEvent":{"type":"object","additionalProperties":false,"required":["type","data"],"properties":{"type":{"const":"room_event"},"data":{"type":"object","additionalProperties":false,"required":["room_id","event_id","body"],"properties":{"room_id":{"$ref":"#/$defs/nonempty"},"event_id":{"$ref":"#/$defs/nonempty"},"body":{"$ref":"#/$defs/bytes"}}}}},
    "emit":{"type":"object","additionalProperties":false,"required":["type","data"],"properties":{"type":{"const":"emit"},"data":{"$ref":"#/$defs/effect"}}},
    "consume":{"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"const":"consume_next_response"}}},
    "cancel":{"type":"object","additionalProperties":false,"required":["type","data"],"properties":{"type":{"const":"cancel"},"data":{"$ref":"#/$defs/operation"}}},
    "stale":{"type":"object","additionalProperties":false,"required":["type","data"],"properties":{"type":{"const":"stale_writer_attempt"},"data":{"type":"object","additionalProperties":false,"required":["holder_id","lease_epoch"],"properties":{"holder_id":{"$ref":"#/$defs/nonempty"},"lease_epoch":{"$ref":"#/$defs/uint"}}}}},
    "operation":{"type":"object","additionalProperties":false,"required":["operation_id"],"properties":{"operation_id":{"$ref":"#/$defs/hash"}}},
    "effect":{"type":"object","additionalProperties":false,"required":["effect_id","kind"],"properties":{"effect_id":{"$ref":"#/$defs/hash"},"kind":{"$ref":"#/$defs/effectKind"}}},
    "effectKind":{"oneOf":[
      {"$ref":"#/$defs/matrixRequest"},{"$ref":"#/$defs/cryptoWrite"},{"$ref":"#/$defs/ingress"},{"$ref":"#/$defs/ciphertext"},{"$ref":"#/$defs/observation"},{"$ref":"#/$defs/cancellation"},{"$ref":"#/$defs/staleRejected"}
    ]},
    "matrixRequest":{"type":"object","additionalProperties":false,"required":["type","data"],"properties":{"type":{"const":"matrix_request"},"data":{"type":"object","additionalProperties":false,"required":["method","path","body"],"properties":{"method":{"$ref":"#/$defs/nonempty"},"path":{"$ref":"#/$defs/nonempty"},"body":{"$ref":"#/$defs/bytes"}}}}},
    "cryptoWrite":{"type":"object","additionalProperties":false,"required":["type","data"],"properties":{"type":{"const":"crypto_store_write"},"data":{"type":"object","additionalProperties":false,"required":["scope","record_type","bytes"],"properties":{"scope":{"$ref":"#/$defs/nonempty"},"record_type":{"$ref":"#/$defs/nonempty"},"bytes":{"$ref":"#/$defs/bytes"}}}}},
    "ingress":{"type":"object","additionalProperties":false,"required":["type","data"],"properties":{"type":{"const":"ingress_disposition"},"data":{"type":"object","additionalProperties":false,"required":["source_id","event_id","disposition"],"properties":{"source_id":{"$ref":"#/$defs/nonempty"},"event_id":{"$ref":"#/$defs/nonempty"},"disposition":{"$ref":"#/$defs/nonempty"}}}}},
    "ciphertext":{"type":"object","additionalProperties":false,"required":["type","data"],"properties":{"type":{"const":"prepared_ciphertext"},"data":{"type":"object","additionalProperties":false,"required":["room_id","bytes"],"properties":{"room_id":{"$ref":"#/$defs/nonempty"},"bytes":{"$ref":"#/$defs/bytes"}}}}},
    "observation":{"type":"object","additionalProperties":false,"required":["type","data"],"properties":{"type":{"const":"observation"},"data":{"type":"object","additionalProperties":false,"required":["name","value"],"properties":{"name":{"$ref":"#/$defs/nonempty"},"value":{"$ref":"#/$defs/text"}}}}},
    "cancellation":{"type":"object","additionalProperties":false,"required":["type","data"],"properties":{"type":{"const":"cancellation"},"data":{"$ref":"#/$defs/operation"}}},
    "staleRejected":{"type":"object","additionalProperties":false,"required":["type","data"],"properties":{"type":{"const":"stale_writer_rejected"},"data":{"type":"object","additionalProperties":false,"required":["holder_id","lease_epoch"],"properties":{"holder_id":{"$ref":"#/$defs/nonempty"},"lease_epoch":{"$ref":"#/$defs/uint"}}}}},
    "failpoint":{"enum":["ledger_before_crypto_store_append","ledger_after_crypto_store_append","ledger_unknown_crypto_store_append","ledger_before_ingress_append","ledger_after_ingress_append","ledger_unknown_ingress_append","candidate_before_prepare","candidate_after_prepare","candidate_after_commit_before_acknowledge","process_before_effect_append","process_after_effect_append","response_before_prepare","response_after_commit_before_acknowledge","before_prepared_ciphertext_handoff","after_prepared_ciphertext_handoff","stale_writer_after_takeover"]}
  }
}
